<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "executable" (slug: executable).
  The release workflow uploads the app's main executable (CadencePlus.exe,
  Cadence.exe or CadenceVideo.exe) as a GitHub artifact; GitHub wraps it in a
  zip, and SignPath signs the .exe inside with Authenticode.
  Paste this into SignPath: Project → Artifact configurations → New.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="*.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>

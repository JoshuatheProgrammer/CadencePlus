{
  "name": "cadence",
  "version": "0.0.0",
  "private": true,
  "description": "Cadence — a free, open-source creative suite: Cadence+ (images), Cadence Video and the Cadence hub",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "plus:dev": "npm run dev -w cadence-plus",
    "plus:build": "npm run build -w cadence-plus",
    "plus:e2e": "npm run e2e -w cadence-plus",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present"
  }
}
